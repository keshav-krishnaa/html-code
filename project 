<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Front Page</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .hero {
            background: linear-gradient(to right, #0d6efd, #0b5ed7);
            color: white;
            padding: 80px 20px;
            text-align: center;
        }

        .hero img {
            width: 90px;
            margin-bottom: 20px;
        }

        .section-padding {
            padding: 60px 20px;
        }

        .card {
            border: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

        footer {
            background-color: #0d6efd;
            color: white;
            padding: 20px 0;
        }
    </style>
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
    <div class="container">
        <a class="navbar-brand" href="#">MyWebsite</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero">
    <img src="https://via.placeholder.com/100" alt="Logo">
    <h1 class="fw-bold">Welcome to MyWebsite</h1>
    <p class="mt-3">We provide modern, reliable, and responsive digital solutions for your business.</p>
</section>

<!-- Features Section -->
<section id="features" class="section-padding">
    <div class="container">
        <h2 class="text-center mb-5">Our Services</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card p-4 text-center">
                    <h5>Web Development</h5>
                    <p>Modern, fast, and responsive websites built with best practices.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-4 text-center">
                    <h5>UI/UX Design</h5>
                    <p>Clean and user-friendly designs that improve user experience.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-4 text-center">
                    <h5>Support</h5>
                    <p>Reliable support and maintenance for long-term success.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="section-padding bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <h2>About Us</h2>
                <p>
                    We are a passionate team dedicated to building professional digital solutions.
                    Our goal is to help businesses grow through clean design and efficient technology.
                </p>
            </div>
            <div class="col-md-6 text-center">
                <img src="https://via.placeholder.com/400x250" class="img-fluid rounded" alt="About Image">
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer id="contact">
    <div class="container text-center">
        <p class="mb-1">© 2025 MyWebsite</p>
        <small>All Rights Reserved</small>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>